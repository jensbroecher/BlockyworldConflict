; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Blockyworld Conflict"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.8", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameSession="*res://autoload/GameSession.gd"
UnitDB="*res://autoload/UnitDB.gd"
Net="*res://autoload/Net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="units"
3d_physics/layer_3="projectiles"
3d_physics/layer_4="buildings"
3d_physics/layer_5="walls"
3d_physics/layer_6="water"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
lights_and_shadows/multi_bounce_occlusion/enabled=true
